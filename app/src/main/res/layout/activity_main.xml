<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ide_bg"
    tools:context="MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        app:titleTextColor="@color/white"
        app:subtitleTextColor="@color/ide_accent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ide_bg"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme" />

    <!-- Warning banner: inverted (white on black app) so it still stands out in monochrome. -->
    <TextView
        android:id="@+id/pair_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="@color/white"
        android:textColor="@color/black"
        android:textSize="13sp"
        android:visibility="gone"
        android:text="⚠ Not paired — open Minima Core → Apps and enable Terminal IDE, then come back. Tap here to open Minima Core." />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        app:tabMode="fixed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/main_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
