<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <!-- Strictly monochrome, like a classic terminal: pure white text on pure black. The one
         panel tone (input bar / dividers) is a visually-black #141414 so the command field
         stays findable; every text colour, including accent/warn/dim, is white. -->
    <color name="ide_bg">#000000</color>
    <color name="ide_bg_light">#141414</color>
    <color name="ide_text">#FFFFFF</color>
    <color name="ide_dim">#FFFFFF</color>
    <color name="ide_accent">#FFFFFF</color>
    <color name="ide_warn">#FFFFFF</color>
</resources>
